# Neon (separate project for this app). Pooled for runtime, direct for migrations.
DATABASE_URL=
DIRECT_URL=
# Neon endpoint IDs (the ep-xxxx-xxxx-xxxxxxxx part of the host, no -pooler) that migrations may run against.
# `npm run db:deploy -- --target prod|dev` refuses unless DIRECT_URL matches. Machine-local; never set on Vercel.
YUMMY_PROD_ENDPOINT=
YUMMY_DEV_ENDPOINT=

# 32 random bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Only while rotating the key (see DEPLOY.md, Key rotation): the OLD key. Remove it afterwards.
ENCRYPTION_KEY_PREVIOUS=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Must be exactly "true" for PLAID_ENV=production (Trial-plan Items are limited and non-recyclable).
ALLOW_PLAID_PRODUCTION=false

# Clover (single merchant, private token)
CLOVER_API_BASE=https://api.clover.com
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=

# Optional passcode login (20+ chars). Unset = passcode login fully disabled. Needs at least one of this or the mailer above.
LOGIN_PASSCODE=

# Owner/cc addresses (seed + report recipients)
# Apps Script mailer (see apps-script/README.md): web app URL ending /exec, and the shared secret
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
OWNER_EMAIL=
CC_EMAIL=

# Auth (allowlist magic link)
ADMIN_USER_EMAILS=
AUTH_SECRET=

# Vercel cron: sent as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

APP_URL=http://localhost:3000
BUSINESS_TIMEZONE=America/Denver

BUSINESS_NAME=

# Local dev only: "true" skips the magic-link login. Ignored in production builds and Vercel deploys.
DEV_AUTH_BYPASS=false

# Optional. OAuth return page: APP_URL + /plaid/oauth. Must also be registered in the Plaid Dashboard
# (Developers > API > Allowed redirect URIs). Required in production; http://localhost is allowed in sandbox.
PLAID_REDIRECT_URI=
