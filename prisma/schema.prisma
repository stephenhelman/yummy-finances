generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventions
// - Every table carries businessId (tenant-ready; single tenant for now).
// - Money is Int cents. Bank amounts follow Plaid: positive = money OUT.
// - Months are "YYYY-MM" strings in the business timezone.

enum PlaidItemStatus {
  OK
  LOGIN_REQUIRED // user must re-authenticate via Link update mode
  PENDING_EXPIRATION // bank consent expires soon; reconnect before it lapses
  ERROR // bank/Plaid-side problem that reconnecting won't fix; see lastErrorCode
}

enum CategorySection {
  REVENUE
  COGS
  OPEX
  OTHER
  NON_PL // sales tax, tips, owner draws, loan principal, capex, transfers
}

// How a category is reported. The owner only ever picks a category; the internal kind is derived from this
// (see src/lib/report/template.ts: PNL_EXPENSE -> EXPENSE / VENDOR_REFUND, PERSONAL -> OWNER_DRAW / OWNER_CONTRIBUTION,
// NON_PL -> the category's nonPlKind, PNL_INCOME -> OTHER_INCOME).
enum CategoryTreatment {
  PNL_EXPENSE
  PNL_INCOME
  NON_PL
  PERSONAL
}

enum RuleMatchType {
  EXACT
  STARTS_WITH
  CONTAINS
  REGEX
}

enum RuleTarget {
  NORMALIZED // matched against the normalized merchant key
  RAW // matched against the bank's raw descriptor
}

enum RuleDirection {
  IN
  OUT
  ANY
}

enum RuleSource {
  SEED // shipped with the app (src/lib/rules/seed.ts)
  USER // created by a person (or recorded as one, e.g. the owner's confirmed rules)
}

// NEEDS_REVIEW: an outflow nothing classified, or an unmatched inflow (OTHER_INFLOW) flagged for a look.
// AUTO: classified by a pair, system rule or rule. REVIEWED: a person categorized it.
enum ReviewStatus {
  NEEDS_REVIEW
  AUTO
  REVIEWED
}

// See src/lib/rules/types.ts. There is deliberately no revenue kind: bank inflows are never revenue
// (revenue comes from Clover). Only EXPENSE and VENDOR_REFUND carry a P&L category.
// TRANSFER and IGNORE are legacy values from before the categorization engine; nothing writes them.
enum TransactionKind {
  EXPENSE
  CLOVER_SETTLEMENT
  CASH_DEPOSIT
  INTERNAL_TRANSFER
  CARD_PAYMENT
  OWNER_DRAW
  OWNER_CONTRIBUTION
  SALES_TAX_REMITTANCE
  LOAN_PAYMENT
  VENDOR_REFUND
  OTHER_INFLOW
  DONATION // a donation: outside the P&L, and not an owner draw (so it never inflates owner-draw totals)
  OTHER_INCOME // the one bank-sourced P&L income: a person picked an "Other Income" category on an inflow (never a rule)
  TRANSFER // legacy
  IGNORE // legacy
}

enum CategorySource {
  NONE
  RULE // a rule (or a system rule, which has no Rule row)
  PAIR // matched with the other side of a transfer / card payment
  MANUAL // a person chose it: automation never overwrites it
}

enum SettlementMatchStatus {
  MATCHED
  NEEDS_REVIEW
  UNMATCHED
}

enum SnapshotStatus {
  DRAFT
  LOCKED
}

// Which timestamp decided a Clover row's saleTime (see src/lib/clover/map.ts).
enum SaleTimeSource {
  CLIENT // device time (clientCreatedTime)
  SERVER // createdTime
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model Business {
  id                   String   @id @default(cuid())
  name                 String
  timezone             String
  fiscalYearStartMonth Int      @default(1)
  // false: Total Sales excludes sales tax and the Sales Tax category stays outside the P&L (cash notes show collected vs
  // remitted). true: Total Sales includes tax collected and Sales Tax is a P&L expense line. Net income is the same either way.
  salesTaxInRevenue    Boolean  @default(false)
  ownerEmail           String
  ccEmail              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  plaidItems     PlaidItem[]
  bankAccounts   BankAccount[]
  bankTxns       BankTransaction[]
  categories     Category[]
  rules          Rule[]
  cloverPayments CloverPayment[]
  cloverRefunds  CloverRefund[]
  settlements    Settlement[]
  snapshots      MonthSnapshot[]
  loginTokens    LoginToken[]
  jobRuns        JobRun[]
  auditLogs      AuditLog[]
  cloverTenders  CloverTender[]
  cloverOrders   CloverOrder[]
  categoryGroups CategoryGroup[]
}

model PlaidItem {
  id              String          @id @default(cuid())
  businessId      String
  business        Business        @relation(fields: [businessId], references: [id])
  plaidItemId     String          @unique
  environment     String // "sandbox" | "production": a sandbox Item is never the real one
  accessTokenEnc  String // AES-256-GCM, see src/lib/crypto.ts
  institutionId   String? // Plaid institution_id; null only on Items connected before multi-bank support
  institutionName String?
  status          PlaidItemStatus @default(OK)
  lastError       String?
  lastErrorCode   String? // Plaid error_code from the last health check; null when OK
  lastCheckedAt   DateTime? // last successful /item/get health check
  cursor          String? // /transactions/sync next_cursor, advanced only after a full page loop is persisted
  lastSyncAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  accounts BankAccount[]

  // One Item per institution per business per environment (several banks are allowed).
  // Trial-plan Items are non-recyclable, so a double submit or race must not be able to
  // create a second Item for a bank that is already connected. Postgres treats NULLs as
  // distinct, so legacy rows without an institutionId never collide (they are backfilled).
  @@unique([businessId, environment, institutionId])
}

model BankAccount {
  id                String    @id @default(cuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id])
  plaidItemId       String
  plaidItem         PlaidItem @relation(fields: [plaidItemId], references: [id])
  plaidAccountId    String    @unique
  name              String
  mask              String?
  type              String?
  subtype           String?
  // Only included accounts are synced. Defaulted from the Plaid type on insert
  // (depository, credit = true; loan, investment, other = false). Once a user
  // flips it (includedSetByUser) account refreshes never change it again.
  included          Boolean   @default(false)
  includedSetByUser Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  transactions BankTransaction[]

  @@index([businessId])
}

// An editable, ordered list of report groups ("Sales/Food", "Other Direct Selling", "Other", "Personal"). A category with no
// group is a top-level line (Wages and Benefits, Rent).
model CategoryGroup {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categories Category[]

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
}

// The report is data-driven from these rows: every non-archived category shows on the accountant's template in
// (group, sortOrder) order, even at $0 unless showWhenZero is off.
model Category {
  id             String            @id @default(cuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id])
  name           String
  // DEPRECATED: the old P&L section. Kept so existing code keeps working; new code reads treatment/group. Set from
  // treatment when a category is created (PNL_EXPENSE -> OPEX, PNL_INCOME -> REVENUE, NON_PL / PERSONAL -> NON_PL).
  section        CategorySection
  key            String? // stable code for template lines the app treats specially ("wages", "sales-tax", ...); survives renames
  groupId        String?
  group          CategoryGroup?    @relation(fields: [groupId], references: [id])
  treatment      CategoryTreatment @default(PNL_EXPENSE)
  nonPlKind      TransactionKind? // NON_PL only: the kind a manual pick derives (Payments -> CARD_PAYMENT, Other Transfers -> INTERNAL_TRANSFER, ...)
  showWhenZero   Boolean           @default(true)
  archived       Boolean           @default(false)
  quickPickOrder Int? // set = one of the Review quick picks, ascending
  sortOrder      Int               @default(0)
  isSystem       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  rules        Rule[]
  transactions BankTransaction[]

  @@unique([businessId, name])
  @@unique([businessId, key])
  @@index([businessId, section])
  @@index([businessId, groupId, sortOrder])
}

model Rule {
  id             String          @id @default(cuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id])
  key            String          @default(cuid()) // stable identity, e.g. "seed:creamland:purchase"; the upsert key for code-defined rules
  name           String          @default("")
  pattern        String // uppercase for EXACT/STARTS_WITH/CONTAINS; a regex source for REGEX
  matchType      RuleMatchType   @default(EXACT)
  target         RuleTarget      @default(NORMALIZED)
  direction      RuleDirection   @default(ANY)
  accounts       Json? // optional account scope: [{ institution?, mask?, type? }] (any of)
  amountMinCents Int? // on the absolute amount, inclusive
  amountMaxCents Int?
  kind           TransactionKind @default(EXPENSE)
  categoryId     String? // required for EXPENSE / VENDOR_REFUND, null for every other kind
  category       Category?       @relation(fields: [categoryId], references: [id])
  priority       Int             @default(100) // lower runs first
  confirmed      Boolean         @default(false) // seeded rules start unconfirmed
  source         RuleSource      @default(USER)
  active         Boolean         @default(true)
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  transactions BankTransaction[]

  @@unique([businessId, key])
  @@index([businessId, active, priority])
}

model BankTransaction {
  id                   String           @id @default(cuid())
  businessId           String
  business             Business         @relation(fields: [businessId], references: [id])
  accountId            String
  account              BankAccount      @relation(fields: [accountId], references: [id])
  plaidTransactionId   String           @unique
  pendingTransactionId String? // on a posted row: the pending row it replaces
  pending              Boolean          @default(false)
  date                 DateTime         @db.Date // Plaid posted/pending date
  authorizedDate       DateTime?        @db.Date
  amountCents          Int // positive = money out
  rawDescription       String // Plaid original_description (falls back to name)
  merchantName         String?
  normalizedMerchant   String? // null until the rules step normalizes it
  paymentChannel       String? // online | in store | other
  pfcPrimary           String? // Plaid personal_finance_category
  pfcDetailed          String?
  pfcConfidence        String?
  pfcVersion           String? // taxonomy version Plaid returned (v1 or v2)
  // Classification (written by src/lib/rules/apply.ts; null kind = an outflow nothing has classified yet)
  kind                 TransactionKind?
  categoryId           String?
  category             Category?        @relation(fields: [categoryId], references: [id])
  categorySource       CategorySource   @default(NONE)
  ruleId               String?
  rule                 Rule?            @relation(fields: [ruleId], references: [id])
  pairId               String? // both sides of a transfer / card payment share it (the smaller of the two transaction ids)
  reviewStatus         ReviewStatus     @default(NEEDS_REVIEW)
  confirmed            Boolean          @default(false) // decided by a confirmed rule, a pair, a system rule or a person
  // Late: dated in an already-locked month. Rolls into the "Prior-month
  // adjustments" line of adjustmentMonth (the open month it was found in).
  isLate               Boolean          @default(false)
  adjustmentMonth      String?
  removedAt            DateTime? // Plaid reported it removed
  supersededAt         DateTime? // a pending row replaced by its posted row
  // Late adjustments: the amount this row contributed to the LOCKED snapshot of its month
  // (0 if it arrived after the lock). Contribution to adjustmentMonth's "Prior-month
  // adjustments" line = (removed ? 0 : amountCents) - adjustmentBaseCents.
  adjustmentBaseCents  Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  settlement Settlement?

  @@index([businessId, date])
  @@index([businessId, categoryId])
  @@index([businessId, kind, categoryId])
  @@index([businessId, pairId])
  @@index([businessId, reviewStatus])
}

model CloverPayment {
  id                String         @id @default(cuid())
  businessId        String
  business          Business       @relation(fields: [businessId], references: [id])
  cloverId          String         @unique
  createdTime       DateTime // server time
  clientCreatedTime DateTime? // device time; differs from createdTime for offline payments
  saleTime          DateTime // the date used for ALL month assignment
  saleTimeSource    SaleTimeSource
  amountCents       Int
  taxCents          Int            @default(0)
  tipCents          Int            @default(0)
  result            String
  orderId           String?
  tenderId          String?
  tenderLabel       String? // from /tenders; payment.tender only carries the id
  isCash            Boolean        @default(false) // derived from the tender label
  // Only result=SUCCESS payments count toward revenue. FAIL rows (retries share
  // an order with the eventual SUCCESS) are stored but flagged excluded.
  excluded          Boolean        @default(false)
  isLate            Boolean        @default(false)
  adjustmentMonth   String?
  raw               Json // trimmed API object (no customers, notes or employee data)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  refunds CloverRefund[]

  @@index([businessId, createdTime])
  @@index([businessId, saleTime])
}

model CloverRefund {
  id                String         @id @default(cuid())
  businessId        String
  business          Business       @relation(fields: [businessId], references: [id])
  cloverId          String         @unique
  cloverPaymentId   String? // Clover's payment id; paymentId is set once that payment is in our DB
  paymentId         String?
  payment           CloverPayment? @relation(fields: [paymentId], references: [id])
  tenderId          String? // the refunded payment's tender
  tenderLabel       String?
  isCash            Boolean        @default(false)
  createdTime       DateTime
  clientCreatedTime DateTime?
  saleTime          DateTime
  saleTimeSource    SaleTimeSource
  amountCents       Int // includes tax and tip per Clover docs
  taxCents          Int            @default(0)
  tipCents          Int            @default(0)
  status            String
  voided            Boolean        @default(false)
  isLate            Boolean        @default(false)
  adjustmentMonth   String?
  raw               Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([businessId, createdTime])
  @@index([businessId, cloverPaymentId])
  @@index([businessId, saleTime])
}

model CloverTender {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  cloverId   String
  label      String
  labelKey   String?
  isCash     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, cloverId])
}

// One row per Clover order, kept only to report discounts (orders are fetched with expand=discounts,lineItems,modifications).
// subtotalCents is the pre-discount subtotal: Σ(line price + modifier amounts), verified on live data to equal what was
// paid before tax on undiscounted orders. The discount of an order is subtotalCents minus what its SUCCESS payments paid
// before tax; the report computes it at read time from CloverPayment, so the two can never disagree.
model CloverOrder {
  id                String    @id @default(cuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id])
  cloverId          String
  createdTime       DateTime
  clientCreatedTime DateTime?
  subtotalCents     Int
  hasDiscount       Boolean   @default(false)
  discountNames     Json? // ["Cash Discount", "Rewards 5%"]: names and percentages only
  testMode          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([businessId, cloverId])
  @@index([businessId, createdTime])
}

model Settlement {
  id                String                @id @default(cuid())
  businessId        String
  business          Business              @relation(fields: [businessId], references: [id])
  bankTransactionId String                @unique
  bankTransaction   BankTransaction       @relation(fields: [bankTransactionId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  depositCents      Int
  cloverGrossCents  Int
  impliedFeeCents   Int
  matchStatus       SettlementMatchStatus
  note              String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([businessId, periodEnd])
}

// Immutable once LOCKED. The data columns are protected by a DB trigger
// (see migration 0003) in addition to the lockMonth() guard in code.
model MonthSnapshot {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id])
  month       String // "YYYY-MM" in business timezone
  status      SnapshotStatus @default(DRAFT)
  dataJson    Json
  inputsHash  String
  lockedAt    DateTime?
  // Delivery state: intentionally mutable after lock.
  pdfBlobKey  String?
  emailSentAt DateTime?
  emailId     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([businessId, month])
}

model LoginToken {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  email      String
  tokenHash  String    @unique // sha256 of the emailed token
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId, email])
}

// Idempotency/visibility for cron jobs (e.g. job="monthly-close", period="2026-09").
model JobRun {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  job        String
  period     String
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?

  @@unique([businessId, job, period])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  actor      String
  action     String
  entity     String?
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}
